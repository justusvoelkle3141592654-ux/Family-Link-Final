<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fingerprint / face unlock for the parent app -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Online sync between the parent and child device -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Foreground app / usage tracking from 00:00 daily -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Lock overlay drawn above every other app -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground monitoring service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Emergency-call button on the lock screen -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      The channel to the separate launcher app. Signature level: only an app signed with the
      same key may read it, which is why both modules share one keystore. No other app on the
      phone can see what this one is enforcing.
    -->
    <permission
        android:name="com.familylink.ios.permission.LAUNCHER_BRIDGE"
        android:protectionLevel="signature" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilyLinkIOS"
        tools:targetApi="34">

        <!--
          Not a home screen. Making this activity the launcher was the first attempt at closing
          the restart gap, and it worked in the wrong way: pressing home opened the parent
          portal, which is a settings screen, not somewhere to live. The home screen is now the
          separate launcher app, which also survives this one being force-stopped.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.FamilyLinkIOS" />

        <!--
          The launcher icon lives on an alias rather than on the activity itself, so it can be
          switched off without disabling the activity every other entry point needs. Removing
          the icon removes the long-press route to "App-Info" and its "Beenden erzwingen",
          which is the one action that stops the guard outright. Only offered once the app is
          the home screen, so it can never leave the parent without a way in.
        -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Block list screen (Listen-Ansicht). Not a screen lock: leavable, single task. -->
        <activity
            android:name=".BlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=".block"
            android:resizeableActivity="false"
            android:supportsPictureInPicture="false"
            android:showOnLockScreen="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.FamilyLinkIOS" />

        <!--
          The PIN in front of the system settings, raised by the accessibility service.
          Its own task and kept out of Recents: it must not become a card the child can swipe
          back to, and it must not drag the portal up behind it.
        -->
        <activity
            android:name=".PinVerificationActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=".pinguard"
            android:resizeableActivity="false"
            android:supportsPictureInPicture="false"
            android:showOnLockScreen="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.FamilyLinkIOS" />

        <!-- Device Administrator: blocks uninstall. Activation must NOT force-lock the device. -->
        <receiver
            android:name=".admin.DeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
            </intent-filter>
        </receiver>

        <!-- Accessibility Service: foreground-app watch + bypass blocking -->
        <service
            android:name=".service.AppAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Foreground service that tracks time and triggers the lock -->
        <service
            android:name=".service.MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parental control usage monitoring and time-limit enforcement" />
        </service>

        <!-- Real-time link between the paired devices -->
        <service
            android:name=".sync.SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Parent side only, and only while notifications are switched on -->
        <service
            android:name=".service.ParentWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          directBootAware: without it this receiver only wakes once the user has unlocked, which
          is exactly the gap someone used to slip into Settings through. Direct boot delivers
          LOCKED_BOOT_COMPLETED before the lock screen is even answered.
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!--
                  The launcher's revive call. This is what brings the guard back after a force
                  stop: a stopped app receives nothing on its own, but the launcher is a running
                  process and can wake it.

                  Deliberately NOT behind the signature permission, unlike the bridge: a
                  permission here would apply to every action in this filter, and the system
                  sends BOOT_COMPLETED under the platform signature, not ours — it would be
                  turned away and the guard would never start after a restart. Leaving the
                  action open costs nothing, because the only thing it can do is start the
                  protection, which is the opposite of a bypass.
                -->
                <action android:name="com.familylink.ios.RESTART" />
            </intent-filter>
        </receiver>

        <!--
          Read-only state for the launcher: which packages are locked right now, and whether
          everything is sealed. The launcher runs in its own process precisely so that force
          stopping this app cannot take the home screen with it.
        -->
        <provider
            android:name=".sync.LauncherBridge"
            android:authorities="com.familylink.ios.launcherbridge"
            android:exported="true"
            android:readPermission="com.familylink.ios.permission.LAUNCHER_BRIDGE" />

    </application>
</manifest>
