<?xml version="1.0" encoding="utf-8"?>
<!--
  Device-admin policy set.

  Purpose: block uninstall while active AND allow the app to lock the screen on demand
  (used only as an anti-tamper reaction when someone opens the admin-deactivation screen or
  this app's App-Info page).

  It grants NO destructive capability:
    * NO <wipe-data/>   -> the app can never factory-reset or erase the device.
    * NO <watch-login/> -> failed-password attempts are not monitored.
  Enabling the admin never locks the screen by itself (see DeviceAdmin.onEnabled).
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
