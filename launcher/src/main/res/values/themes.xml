<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Wallpaper shows through, and the bars are transparent so the grid runs edge to edge.
      windowShowWallpaper is the whole trick: no bitmap is loaded or stored by this app, the
      system simply composites its own wallpaper behind the window.
    -->
    <style name="Theme.Launcher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
